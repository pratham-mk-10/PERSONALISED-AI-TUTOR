# Preferred for cloud deployments (Railway, Render, Neon, etc.)
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/question_bank

# Optional: set if your provider requires SSL (common in production)
DB_SSLMODE=

# Fallback local config (used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=question_bank
DB_USER=postgres
DB_PASSWORD=change_me
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
USE_LLM=true
